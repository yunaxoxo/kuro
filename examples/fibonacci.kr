// Recursive Fibonacci.
//
// Exercises: function calls, recursion, if/else, while, int and float math.
// `main` prints fib(0) through fib(10), then an approximation of the golden
// ratio, and returns fib(20).

fn fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// The ratio of consecutive Fibonacci numbers converges to the golden ratio.
// Iterating x = 1 + 1/x computes exactly that sequence of ratios.
fn golden_ratio(steps: int) -> float {
    let x = 1.0;
    let i = 0;
    while i < steps {
        x = 1.0 + 1.0 / x;
        i = i + 1;
    }
    return x;
}

fn main() -> int {
    let i = 0;
    while i <= 10 {
        print_int(fib(i));
        i = i + 1;
    }
    print_float(golden_ratio(30));
    return fib(20);
}
